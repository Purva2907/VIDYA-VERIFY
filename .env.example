# VIDYA-VERIFY Environment Configuration Template
# Duplicate this file to .env and adjust variables for your local setup

# Backend Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=sandbox
SECRET_SALT=your_custom_salt_here

# Database Configuration (SQLAlchemy)
# Local development default: SQLite
DATABASE_URL=sqlite:///./vidya_verify.db
# Production / Staging PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://vidya_user:vidya_secure_pass@localhost:5432/vidya_verify_db

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:8000
